# Juggernaught Steward — security + maintenance daemon (installed by install.sh)
[Unit]
Description=Juggernaught Steward
After=network-online.target nftables.service
Wants=nftables.service

[Service]
Type=simple
User=jugg-steward
# Primary group `jugg`: the socket (0660) is reachable by the app and nobody else.
Group=jugg
SupplementaryGroups=systemd-journal
Environment=JUGG_CONFIG=/etc/juggernaught/juggernaught.toml
Environment=RUST_LOG=info
ExecStart=/opt/juggernaught/current/bin/juggernaught steward
Restart=always
RestartSec=2
RuntimeDirectory=juggernaught
RuntimeDirectoryMode=0750
StateDirectory=juggernaught-steward
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
ReadOnlyPaths=/opt/juggernaught /etc/juggernaught /var/lib/juggernaught/backups
MemoryMax=256M
UMask=0007

[Install]
WantedBy=multi-user.target
