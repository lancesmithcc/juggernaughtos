# Juggernaught OS — admin app + public site (installed by install.sh)
[Unit]
Description=Juggernaught OS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jugg
Group=jugg
Environment=JUGG_CONFIG=/etc/juggernaught/juggernaught.toml
Environment=LEPTOS_SITE_ROOT=/opt/juggernaught/current/site
Environment=RUST_LOG=info,sqlx=warn
# SMTP password: systemd-creds encrypt, then LoadCredentialEncrypted=smtp_password:/etc/juggernaught/smtp_password.cred
ExecStart=/opt/juggernaught/current/bin/juggernaught serve
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# User namespaces stay available: bubblewrap sandboxes the creative tools with them.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/juggernaught
ReadOnlyPaths=/etc/juggernaught
MemoryMax=80%
CPUQuota=350%
UMask=0077

[Install]
WantedBy=multi-user.target
